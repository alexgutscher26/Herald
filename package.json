{
  "name": "herald",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "bun --bun next build",
    "postbuild": "bun scripts/check-bundle-budget.ts",
    "build:sourcemaps": "bun run build && bun run observability:sourcemaps",
    "start": "bun --bun next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit",
    "test:unit": "bun test tests --path-ignore-patterns '**/integration/**' --path-ignore-patterns '**/browser/**' --path-ignore-patterns '**/e2e/**'",
    "test:integration": "bun --conditions=react-server test tests/integration --concurrency=1",
    "test:smoke": "bun run build && bun --conditions=react-server test tests/integration/dashboard-shell.test.ts",
    "test:browser": "playwright test",
    "e2e:db": "bun scripts/e2e/setup-db.ts",
    "e2e:seed": "bun --conditions=react-server scripts/e2e/seed.ts",
    "e2e:build": "bun scripts/e2e/next.ts build",
    "e2e:serve": "bun run e2e:db && bun run e2e:seed && bun scripts/e2e/next.ts start",
    "e2e": "playwright test -c playwright.e2e.config.ts --project=e2e",
    "e2e:visual": "playwright test -c playwright.e2e.config.ts --project=visual",
    "test:coverage": "bun --conditions=react-server test tests/api-v1.test.ts tests/billing-policy.test.ts tests/permissions.test.ts tests/plan-gates.test.ts tests/integration/account-lifecycle.test.ts tests/integration/api-v1.test.ts tests/integration/billing.test.ts tests/integration/customer-auth.test.ts tests/integration/cross-tenant.test.ts tests/integration/workspace-access.test.ts tests/integration/openapi-contract.test.ts --concurrency=1 --coverage --coverage-reporter=lcov --coverage-dir=coverage && bun scripts/check-coverage.ts",
    "migration:drift": "bun scripts/migration-drift.ts",
    "flaky:report": "bun scripts/flaky-report.ts",
    "test:all": "bun run test:unit && bun run test:integration",
    "check:no-mocks": "bash scripts/check-no-mocks.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reconcile-boards": "bun scripts/reconcile-board-backfill.ts",
    "db:migrate-release-covers": "bun --conditions=react-server scripts/migrate-release-covers.ts",
    "db:reset": "bun scripts/reset-db.ts",
    "db:seed": "bun --conditions=react-server scripts/seed-existing-accounts.ts",
    "db:seed-demo": "bun --conditions=react-server scripts/seed-existing-accounts.ts",
    "db:seed-herald": "bun --conditions=react-server scripts/seed-herald-roadmap.ts",
    "db:import-help": "bun --conditions=react-server scripts/import-herald-help.ts",
    "db:studio": "drizzle-kit studio",
    "check:auth-schema": "bun scripts/check-auth-schema.ts",
    "perf:seed": "bun scripts/perf-seed.ts",
    "perf:plan": "bun scripts/perf-plan.ts",
    "perf:load": "bun scripts/perf-load.ts",
    "perf:surfaces": "bun --conditions=react-server scripts/perf-surfaces.ts",
    "perf:cold": "bun scripts/perf-cold-start.ts",
    "analytics:signup-funnel": "bun --conditions=react-server scripts/signup-funnel.ts",
    "alerts:test": "bun --conditions=react-server scripts/test-alert-channel.ts",
    "backups:verify": "bun --conditions=react-server scripts/verify-backups.ts",
    "observability:sourcemaps": "bun scripts/upload-sourcemaps.ts"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@better-auth/scim": "^1.7.18",
    "@better-auth/sso": "^1.7.18",
    "@hookform/resolvers": "^6.0.0",
    "@posthog/nextjs-config": "^1.12.2",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "^16.4.6",
    "pg": "^8.16.3",
    "posthog-node": "^6.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "globals": "^17.13.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}