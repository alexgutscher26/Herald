# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored. Never commit real secrets, and never prefix any of
# these with NEXT_PUBLIC_ — everything below is server-side only.
# ---------------------------------------------------------------------------

# Required ---------------------------------------------------------------

# Neon Postgres connection string (session/pooler endpoint).
# Use the pooled "pooler" host Neon shows in its dashboard, e.g.
# postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/DBNAME?sslmode=verify-full
DATABASE_URL=

# Secret used by Better Auth to sign sessions and CSRF tokens.
# Generate with: openssl rand -base64 32
# Must be at least 32 characters in production.
BETTER_AUTH_SECRET=

# Canonical public origin of the app, e.g. http://localhost:3000
# Used as Better Auth's baseURL for callbacks and redirects. No trailing slash.
BETTER_AUTH_URL=

# Optional ---------------------------------------------------------------

# Test-only. Postgres server used by `bun run test:integration`. The harness
# creates a uniquely named `herald_test_*` database, applies every migration to
# it, drops it afterwards, and needs a role with CREATEDB. Nothing is written
# to the database named here. Left unset, integration tests fall back to
# DATABASE_URL only when it points at a loopback host.
# TEST_DATABASE_URL=
# Database pool tuning (optional). Each app process opens its own pool, so keep
# `instances x DATABASE_POOL_MAX` below the pooled endpoint connection limit
# (see docs/operations.md). Default 10, clamped to 1-50.
# DATABASE_POOL_MAX=10

# Slow-query logging (optional). A statement at or above SLOW_QUERY_MS logs a
# `db.slow_query` warning; at or above SLOW_QUERY_ALERT_MS it is also sent to
# ERROR_WEBHOOK_URL. Defaults are 200 and 1000 ms.
# SLOW_QUERY_MS=200
# SLOW_QUERY_ALERT_MS=1000

# TTL for the immutable public release/help payload cache, in seconds. 0
# disables it. Default 60.
# PUBLIC_PAYLOAD_TTL_SECONDS=60

# Shared secret for the scheduled endpoints: /api/cron/publish-releases
# (publishes releases whose time has arrived) and /api/cron/jobs (runs the
# background queue). While unset, both answer 503 and do no work. Send it as
# `Authorization: Bearer <value>` from your scheduler.
# Generate with: openssl rand -hex 24
# CRON_SECRET=

# Outbound email (optional) ------------------------------------------------

# Resend API key, sent as a bearer token from the server only.
# https://resend.com/api-keys
# While both email values are unset, email is disabled and pending deliveries
# are marked failed with a clear message. Setting only one of the pair is a
# configuration error.
# RESEND_API_KEY=

# Sender shown to recipients, e.g. Herald <updates@example.com>. The domain
# (or address) must be verified with the provider or sends are rejected.
# EMAIL_FROM=

# Optional endpoint override, defaulting to https://api.resend.com/emails.
# Used by the integration tests to run the real adapter against a local server;
# leave it unset in production.
# EMAIL_API_URL=

# Resend webhook signing secrets (Resend dashboard -> Webhooks). Each endpoint
# has its own `whsec_...` value. Set the inbound one for email.received and the
# delivery one for delivered/bounced/complained. Without them those signed
# routes answer 503.
# RESEND_INBOUND_WEBHOOK_SECRET=
# RESEND_WEBHOOK_SECRET=

# Bearer secret for the normalized delivery batch. The signed Resend route does
# not need it; it remains for compatible providers and integration tests.
# EMAIL_WEBHOOK_SECRET=

# Inbound support email (optional) ---------------------------------------

# Domain used for generated addresses:
#   support+<product token>@domain   starts a thread
#   reply+<thread token>@domain      continues one
# Point its MX records at your inbound adapter. Defaults to
# inbound.herald.local, which only works for local tests.
# EMAIL_INBOUND_DOMAIN=

# Bearer secret for normalized POST /api/email/inbound requests. Signed
# Resend email.received events use RESEND_INBOUND_WEBHOOK_SECRET instead. The
# normalized path refuses every request while this is unset or shorter than 24
# characters.
# Generate with: openssl rand -hex 24
# EMAIL_INBOUND_SECRET=

# Moderation image scanning (optional) -----------------------------------

# Image-text provider used to check attachments for sensitive information.
# Contract: multipart POST with a `file` part (the image) and a JSON response
# containing `{ "text": "..." }` (also accepts `{ "result": { "text" } }`).
# Supported inputs are PNG, JPEG and WebP. While unset, image checks are
# recorded as unavailable and can be retried after configuration; a board that
# blocks sensitive information refuses unscanned images rather than guessing.
# OCR_API_URL=
# OCR_API_KEY=

# AI changelog drafting (optional) ---------------------------------------

# Any OpenAI-compatible chat-completions endpoint. Include the API version in
# the base URL, e.g. https://api.openai.com/v1; the server appends
# /chat/completions. While unset, "Draft with AI" explains that drafting is
# not configured. Set AI_API_URL and AI_MODEL together; AI_API_KEY is optional
# for a local endpoint that does not require auth.
# AI_API_URL=
# AI_API_KEY=
# AI_MODEL=
#
# Optional embedding model for Juno knowledge. Unset uses a deterministic
# local embedding so document text is never sent to a provider. Changing the
# model requires re-ingesting every source.
# AI_EMBEDDING_MODEL=

# File storage (optional) -------------------------------------------------

# Directory used by the local storage driver. Defaults to `.storage/` in the
# project root, which is git-ignored. Serverless hosts need a persistent volume
# or a cloud driver implementing src/features/storage/types.ts. Object URLs are
# signed with a key derived from BETTER_AUTH_SECRET, so rotating that secret
# invalidates every outstanding URL.
# STORAGE_DIR=

# Observability and feature flags (optional) ------------------------------

# Deployment-wide kill switches. Accept on/off, true/false, 1/0; an unset or
# unrecognised value uses the default shown. A flag is not an entitlement:
# public feedback also requires the workspace's plan to include it.
# FLAG_PUBLIC_FEEDBACK=on
# FLAG_WIDGET=on
# FLAG_API=off
# The REST API (/api/v1) and MCP endpoint (/api/mcp) are implemented but off by
# default. Set FLAG_API=on to let workspace API tokens authenticate. The
# OpenAPI document and OAuth discovery metadata stay public.

# Idempotency replay window, 1-168 hours. Default 24.
# API_IDEMPOTENCY_TTL_HOURS=24

# Herald widget (optional) -----------------------------------------------

# Mount the widget on Herald pages, pointing at a workspace and product in
# this deployment. All three values are required together; while any is unset
# no widget script is rendered. Both slugs are lowercase: the loader builds the
# workspace/product pair itself, so PRODUCT is the product slug alone, not
# `workspace/product`. The key is the public installation key printed on that
# product page under Widget (it is not a secret).
# HERALD_WIDGET_WORKSPACE=
# HERALD_WIDGET_PRODUCT=
# HERALD_WIDGET_KEY=

# Slack (optional) -------------------------------------------------------

# Slack app credentials for the per-product integration. All three are
# required together; leave all unset to disable the Integrations card. The app
# needs an Events API request URL of
#   <BETTER_AUTH_URL>/api/integrations/slack/events
# and an OAuth redirect URL of
#   <BETTER_AUTH_URL>/api/integrations/slack/callback
# Scopes: channels:history, channels:read, chat:write, commands, groups:history,
# groups:read, links:read, links:write, team:read. Events: message.channels,
# message.groups and link_shared. Slash command request URL:
#   <BETTER_AUTH_URL>/api/integrations/slack/commands
# Invite the bot to each watched channel, then choose that channel in the
# product's Integrations page.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# Optional overrides, useful for local tests. The redirect defaults to
# <BETTER_AUTH_URL>/api/integrations/slack/callback.
# SLACK_REDIRECT_URI=
# SLACK_API_URL=https://slack.com/api
# SLACK_AUTHORIZE_URL=https://slack.com/oauth/v2/authorize

# GitHub App (optional) ---------------------------------------------------

# Private-repository imports use a GitHub App installation instead of a
# personal access token. Create an App, set its Setup URL to
#   <BETTER_AUTH_URL>/api/integrations/github/callback
# and copy the App id, URL slug and private key here. The private key may keep
# literal \n escapes (as in a .env file) or real PEM newlines. Installation
# tokens are minted on demand and never stored.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=herald-feedback
# GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Stripe billing (optional) -----------------------------------------------

# Leave all four required values unset to disable billing. They must be set
# together. Create one recurring price for Starter and one for Professional in
# Stripe, then paste the price ids (price_…), not the product ids. Checkout
# starts a 14-day trial; the signed webhook keeps workspace_subscriptions and
# the workspace plan in sync. Register the endpoint at
#   <BETTER_AUTH_URL>/api/webhooks/stripe
# for checkout.session.completed, checkout.session.expired,
# customer.subscription.* and charge.refunded events.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=
# Optional annual prices. Set both or neither; when set, the billing screen
# offers annual checkout at the same plan limits. Monthly prices are still
# required.
# STRIPE_PRICE_STARTER_ANNUAL=
# STRIPE_PRICE_PRO_ANNUAL=
# Optional one-time $499 price for Founding Lifetime. When unset the offer
# shows as unavailable; the rest of billing keeps working. Setting it without
# the four required values fails closed at startup.
# STRIPE_PRICE_LIFETIME=
# Optional endpoint override for local tests; leave unset in production.
# STRIPE_API_URL=https://api.stripe.com

# Sandbox mode (optional): accept on/off, true/false, 1/0. While on, outbound
# email and webhook calls are suppressed: notification deliveries are marked
# skipped and no provider or receiver is contacted. Database writes, outbox
# rows and audit fields still work, so flows can be tested safely.
# SANDBOX_MODE=off

# Absolute http(s) URL that receives compact JSON error payloads. Errors are
# always written to the structured log first; this only forwards them, with a
# three-second timeout, and a failure here never fails the request.
# ERROR_WEBHOOK_URL=

# Error tracking and alerting (optional) ----------------------------------

# Sentry-compatible DSN, e.g. https://KEY@o0.ingest.sentry.io/PROJECT_ID.
# When set, errors are POSTed with the release and environment tags below;
# when unset, the structured log and ERROR_WEBHOOK_URL are the channels.
# Any Sentry SaaS, self-hosted Sentry or compatible relay works.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# Release id shared by error events and the source-map upload. Defaults to
# VERCEL_GIT_COMMIT_SHA, then "dev". Source maps: `bun run build:sourcemaps`
# needs SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN and this value.
# RELEASE_VERSION=

# Product analytics (optional) ---------------------------------------------
# PostHog ingestion for the events Herald already records for its own
# dashboards: public board and portal views, and the sign-up funnel stages.
# Capture is server-side only, so no browser SDK, PostHog cookie or visitor
# identifier is ever created on a visitor's device. Public events pass the same
# consent gate as the first-party rows, and distinct ids are one-way hashes
# rather than emails, account ids, IP addresses or user agents.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# Source maps for PostHog error tracking, read only at build time. With both
# set, `bun run build` uploads the server maps for the release so PostHog can
# symbolicate traces, then deletes the local copies. The personal key needs the
# source-map upload scope and must never be sent to the browser.
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID=

# Aggregate alert transitions (5xx rate, job failures, queue depth, email
# bounce rate, webhook failures, AI spend, backup freshness). Falls back to
# ERROR_WEBHOOK_URL when unset.
# ALERT_WEBHOOK_URL=
# ALERT_5XX_RATE_PCT=2
# ALERT_MIN_REQUESTS=20
# ALERT_JOB_FAILURE_RATE_PCT=10
# ALERT_MIN_JOB_CLAIMS=5
# ALERT_QUEUE_DEPTH=50
# ALERT_QUEUE_AGE_MINUTES=10
# ALERT_EMAIL_BOUNCE_RATE_PCT=2
# ALERT_MIN_DELIVERIES=20
# ALERT_WEBHOOK_FAILURE_RATE_PCT=5
# ALERT_MIN_WEBHOOK_ATTEMPTS=20
# ALERT_AI_DAILY_USD=25
# ALERT_BACKUP_MAX_AGE_HOURS=26

# APM thresholds. A route or span over its threshold logs a warning; a span
# below it is silent unless TRACE_LOG_ALL=on.
# SLOW_ROUTE_MS=1000
# SLOW_SPAN_MS=750
# TRACE_LOG_ALL=off

# Observability retention. Request metrics are one aggregate row per route,
# method, status class and minute; dashboard views are section-level only.
# REQUEST_METRICS_RETENTION_DAYS=7
# DASHBOARD_VIEW_RETENTION_DAYS=180
# AI_USAGE_RETENTION_DAYS=400
# BACKUP_VERIFICATION_RETENTION_DAYS=90
# BACKUP_MANIFEST_RETENTION_DAYS=35

# Cost estimates for the internal dashboard. These are estimates, not an
# invoice; override them for the provider plan actually in use.
# AI_INPUT_USD_PER_MTOK=0.5
# AI_OUTPUT_USD_PER_MTOK=1.5
# COST_DB_GB_MONTH_USD=0.35
# COST_STORAGE_GB_MONTH_USD=0.023
# COST_EMAIL_PER_1000_USD=1

# Comma-separated signed-in addresses allowed to open /app/admin. Workspace
# roles are irrelevant here: this dashboard shows deployment-wide counts and
# must never be visible to a customer-side admin. Empty disables the page (404).
# INTERNAL_ADMIN_EMAILS=ops@example.com

# Source-map upload (build step only; do not expose SENTRY_AUTH_TOKEN to the
# running app). `bun run build:sourcemaps` creates the release, injects debug
# ids and uploads `.next/server` maps. Without all four values it skips.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
